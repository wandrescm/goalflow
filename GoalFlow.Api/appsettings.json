{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mensajeria": {
    "CicloHabilitado": true,
    "CapacidadDelCanal": 64,
    "PeriodoDelTemporizador": "00:01:00",
    "LotePorTenant": 10,
    "DuracionDelLease": "00:05:00",
    "TimeoutDelConsumidor": "00:02:00",
    "MaximoDeIntentos": 5,
    "BackoffInicial": "00:00:30",
    "BackoffMaximo": "00:30:00"
  },
  "Auth": {
    "JwksRefreshSeconds": 3600,
    "JwksMinRefreshSeconds": 300,
    "JwksFailureBackoffSeconds": 30
  },
  "AllowedHosts": "*"
}
