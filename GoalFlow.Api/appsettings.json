{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mensajeria": {
    "CicloHabilitado": true,
    "CapacidadDelCanal": 64,
    "PeriodoDelTemporizador": "00:01:00",
    "LotePorTenant": 10,
    "DuracionDelLease": "00:05:00",
    "TimeoutDelConsumidor": "00:02:00",
    "MaximoDeIntentos": 5,
    "BackoffInicial": "00:00:30",
    "BackoffMaximo": "00:30:00"
  },
  "IA": {
    "Habilitada": false,
    "Modelo": "claude-haiku-5-5",
    "PrecioEntradaMicroUsdPorMTok": 100000,
    "PrecioSalidaMicroUsdPorMTok": 500000,
    "TopeMensualPorLigaMicroUsd": 1500000,
    "TopeMensualGlobalMicroUsd": 3000000,
    "MaximoDeLlamadasPorHuella": 3,
    "MaxTokensDeSalida": 600,
    "MaximoDeBytesDeEntrada": 16384,
    "MaximoDeTokensDeEntrada": 8000,
    "MargenDeEntradaPorcentaje": 10,
    "MargenDeEntradaTokens": 50,
    "Razonamiento": "Deshabilitado",
    "LongitudMaximaDeBorrador": 4000,
    "TimeoutDeLlamada": "00:01:00",
    "Backfill": {
      "EjecutarAlArrancar": false
    }
  },
  "Auth": {
    "JwksRefreshSeconds": 3600,
    "JwksMinRefreshSeconds": 300,
    "JwksFailureBackoffSeconds": 30
  },
  "AllowedHosts": "*"
}
